ic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "A calculated measurement in which the number of lymphocytes in a specified sample of blood is divided by the total number of white blood cells in the sample, and the result presented as a ratio, fraction, quotient or percentage. ", "disease_id": "EFO_0007993", "disease_name": "lymphocyte percentage of leukocytes", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.4990140615260509}], "evidence_count_total": 1, "max_datatype_score": 0.4990140615260509, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "The mass of a fat pad.", "disease_id": "OBA_0004528", "disease_name": "fat pad mass", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 3, "score": 0.49336934074887057}], "evidence_count_total": 3, "max_datatype_score": 0.49336934074887057, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "The circumference of a hip.", "disease_id": "OBA_1000032", "disease_name": "hip circumference", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 2, "score": 0.4827906494532212}], "evidence_count_total": 2, "max_datatype_score": 0.4827906494532212, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "A carcinoma arising from squamous epithelial cells. Morphologically, it is characterized by the proliferation of atypical, often pleomorphic squamous cells. Squamous cell carcinomas are graded by the degree of cellular differentiation as well, moderately, or poorly differentiated. Well differentiated carcinomas are usually associated with keratin production and the presence of intercellular bridges between adjacent cells. Representative examples are lung squamous cell carcinoma, skin squamous cell carcinoma, and cervical squamous cell carcinoma.", "disease_id": "EFO_0000707", "disease_name": "squamous cell carcinoma", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.43598382378313166}, {"datatype_id": "literature", "evidence_count": 1, "score": 0.024317231904464845}], "evidence_count_total": 2, "max_datatype_score": 0.43598382378313166, "therapeutic_areas": [{"id": "MONDO_0045024", "name": "cancer or benign tumor"}]}, {"disease_description": "The amount of a globulin type when measured in blood serum.", "disease_id": "OBA_2045206", "disease_name": "level of serum globulin type protein", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.40112114266766485}], "evidence_count_total": 1, "max_datatype_score": 0.40112114266766485, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "Quantification of the amount of body fat as a percentage of total body mass, calculated as either total mass of fat divided by total body mass or one of a number of more complex weighted equations. Body fat includes essential body fat and storage body fat. ", "disease_id": "EFO_0007800", "disease_name": "body fat percentage", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.3919363132623927}], "evidence_count_total": 1, "max_datatype_score": 0.3919363132623927, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "A calculated measurement in which the number of neutrophil granulocytes is divided by the number of all white blood cells in a specified sample of peripheral venous blood, and the result presented as a ratio, fraction, quotient or percentage. A neutrophil is, or is in the process of becoming, a granular leucocyte having a nucleus with three to five lobes connected by threads of chromatin, cytoplasm containing very fine granules, and which is readily stainable with neutral dyes.", "disease_id": "EFO_0007990", "disease_name": "neutrophil percentage of leukocytes", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.3688006717078542}], "evidence_count_total": 1, "max_datatype_score": 0.3688006717078542, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms.", "disease_id": "EFO_0004338", "disease_name": "body weight", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.363417344763314}], "evidence_count_total": 1, "max_datatype_score": 0.363417344763314, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "C-reactive protein (CRP) measurement is a measurement of the level of C-reactive protein in the blood.  Levels are known to rise in response to inflammation, CRP is therefore used as a clinical measure of inflammation. The measurement is used in the process of clinical diagnosis as high levels of CRP are associated with cardiovascular disease, diabetes and hypertension and in some cancers.", "disease_id": "EFO_0004458", "disease_name": "C-reactive protein measurement", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 2, "score": 0.34629682778862103}], "evidence_count_total": 2, "max_datatype_score": 0.34629682778862103, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "An indicator of body density as determined by the relationship of BODY WEIGHT\u00a0to\u00a0BODY HEIGHT. BMI=weight (kg)/height squared (m2). BMI correlates with body fat (ADIPOSE TISSUE). Their relationship varies with age and gender. For adults, BMI falls into these categories: below 18.5 (underweight); 18.5-24.9 (normal); 25.0-29.9 (overweight); 30.0 and above (obese). (National Center for Health Statistics, Centers for Disease Control and Prevention)", "disease_id": "EFO_0004340", "disease_name": "body mass index", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.3411454850396506}], "evidence_count_total": 1, "max_datatype_score": 0.3411454850396506, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "Persistently high systemic arterial blood pressure. Based on multiple readings (blood pressure determination), hypertension is currently defined as when systolic pressure is consistently greater than 140 mm Hg or when diastolic pressure is consistently 90 mm Hg or more.", "disease_id": "EFO_0000537", "disease_name": "hypertension", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.22460831475748202}], "evidence_count_total": 1, "max_datatype_score": 0.22460831475748202, "therapeutic_areas": [{"id": "EFO_0000319", "name": "cardiovascular disease"}]}, {"disease_description": "Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus from a xenobiotic, a compound foreign to the organism exposed to it. It may be synthesized by another organism (like ampicilin) or it can be a synthetic chemical.", "disease_id": "GO_0009410", "disease_name": "response to xenobiotic stimulus", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.22460831475748202}], "evidence_count_total": 1, "max_datatype_score": 0.22460831475748202, "therapeutic_areas": [{"id": "GO_0008150", "name": "biological_process"}]}, {"disease_description": "Inflammation of a vein.", "disease_id": "EFO_1001395", "disease_name": "Phlebitis", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.20875365324266476}], "evidence_count_total": 1, "max_datatype_score": 0.20875365324266476, "therapeutic_areas": [{"id": "EFO_0000319", "name": "cardiovascular disease"}]}, {"disease_description": "Inflammation of a vein associated with venous thrombosis (blood clot formation within the vein).", "disease_id": "HP_0004418", "disease_name": "Thrombophlebitis", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.20875365324266476}], "evidence_count_total": 1, "max_datatype_score": 0.20875365324266476, "therapeutic_areas": [{"id": "EFO_0000651", "name": "phenotype"}]}, {"disease_description": "The weight of all organs and tissue in an individual less the weight of the individual's body fat.", "disease_id": "EFO_0004995", "disease_name": "lean body mass", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.20828047197584365}], "evidence_count_total": 1, "max_datatype_score": 0.20828047197584365, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "quantification of monocytes in the blood", "disease_id": "EFO_0005091", "disease_name": "monocyte count", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.20813803022833255}], "evidence_count_total": 1, "max_datatype_score": 0.20813803022833255, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "Quantification of cholesterol to total lipids in large LDL.", "disease_id": "EFO_0022235", "disease_name": "cholesterol to total lipids in large LDL percentage ", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.12077636133821643}], "evidence_count_total": 1, "max_datatype_score": 0.12077636133821643, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "Red blood cell distribution width (RDW or RDW-CV or RCDW and RDW-SD) is a measure of the range of variation of red blood cell (RBC) volume that is reported as part of a standard complete blood count. Usually red blood cells are a standard size of about 6-8 \u03bcm in diameter. Certain disorders, however, cause a significant variation in cell size. Higher RDW values indicate greater variation in size. Normal reference range of RDW-CV in human red blood cells is 11.5-14.5%.[1] If anemia is observed, RDW test results are often used together with mean corpuscular volume (MCV) results to determine the possible causes of the anemia. It is mainly used to differentiate an anemia of mixed causes from an anemia of a single cause.", "disease_id": "EFO_0009188", "disease_name": "Red cell distribution width", "ensembl_gene_id": "ENSG00000286075", "evidence_by_datatype": [{"datatype_id": "genetic_association", "evidence_count": 1, "score": 0.05349239757461683}], "evidence_count_total": 1, "max_datatype_score": 0.05349239757461683, "therapeutic_areas": [{"id": "EFO_0001444", "name": "measurement"}]}, {"disease_description": "A tumor composed of atypical neoplastic, often pleomorphic cells that invade other tissues. Malignant neoplasms often metastasize to distant anatomic sites and may recur after excision. The most common malignant neoplasms are carcinomas (adenocarcinomas or squamous cell carcinomas), Hodgkin and non-Hodgkin lymphomas, leukemias, melanomas, and sarcomas.", "disease_id": "MONDO_0004992", "disease_name": "cancer", "ensembl_gene_id": "ENSG00000286075", "evidence_by_da